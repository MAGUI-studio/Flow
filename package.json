{
  "name": "flow",
  "version": "1.0.0",
  "description": "Flow — SaaS de agendamentos da MAGUI.studio",
  "scripts": {
    "stripe:setup": "tsx scripts/setup-stripe.ts",
    "stripe:verify": "tsx scripts/verify-stripe.ts",
    "test:billing": "tsx --test tests/billing.integration.ts",
    "test:admin": "tsx --test tests/admin-policy.test.ts tests/admin-filters.test.ts tests/admin-access.test.ts tests/admin-records.integration.ts",
    "secrets:check": "node scripts/check-staged-secrets.mjs",
    "stripe:listen": "node scripts/stripe-listen.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:app": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test:db": "tsx --test tests/db.integration.ts tests/booking-completion.integration.ts tests/business-profile.integration.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:account": "tsx scripts/seed-account.ts",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "build:homolog": "node scripts/run-homolog.mjs build",
    "start:homolog": "node scripts/run-homolog.mjs start",
    "verify:homolog": "tsx scripts/verify-homolog.ts",
    "test:journey": "tsx --test tests/journey.integration.ts tests/scheduling.integration.ts",
    "test:e2e": "playwright test"
  },
  "keywords": [],
  "type": "module",
  "private": true,
  "dependencies": {
    "@clerk/localizations": "latest",
    "@clerk/nextjs": "^7.9.15",
